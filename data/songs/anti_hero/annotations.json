    {
      "line_index": 0,
      "lyric_text": "I have this thing, where I get older but just never wiser",
      "summary": "开篇自嘲：年岁渐长智慧不增。Midnights 的「深夜自省」母题第一句就点题。",
      "metaphor_analysis": null,
      "allusions": [],
      "wordplay": null,
      "emotional_tone": "self-doubt",
      "cultural_context": null,
      "taylor_swift_context": "Taylor 称 Anti-Hero 是她「最诚实的歌之一」：把最讨厌自己的部分写成了热单。",
      "related_lines": [],
      "emotion_valence": 0.35,
