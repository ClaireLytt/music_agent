      "emotion_category": "self-doubt"
    },
    {
      "line_index": 1,
      "lyric_text": "Midnights become my afternoons",
      "summary": "昼夜颠倒的失眠意象：午夜成了下午——抑郁与自我审视把时间结构溶解了。",
      "metaphor_analysis": "时间错乱=心理秩序崩塌。同时点出专辑名 Midnights 的概念：13 个不眠之夜。",
      "allusions": [],
      "wordplay": null,
      "emotional_tone": "mystery",
      "cultural_context": null,
      "taylor_swift_context": null,
      "related_lines": [],
      "emotion_valence": 0.3,
      "emotion_arousal": 0.35,
      "emotion_category": "mystery"
    },
    {
      "line_index": 13,
      "lyric_text": "I'm the problem, it's me",
      "summary": "病毒式传播的核心句：「问题在我」。用会议出席的口吻（Hi!）自我点名，反讽中带着真诚的自我指认。",
      "metaphor_analysis": null,
      "allusions": [],
      "wordplay": "「It's me, hi」模拟点名/自我介绍场景，把内心审判庭具象成一场尴尬的会议。",
      "emotional_tone": "self-doubt",
      "cultural_context": "发行后成为 TikTok 现象级 meme，「自我问题化」的表达进入日常语言。",
      "taylor_swift_context": null,
      "related_lines": [
