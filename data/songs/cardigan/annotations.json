  "annotations": [
    {
      "line_index": 0,
      "lyric_text": "Vintage tee, brand new phone",
      "summary": "开篇用两个物件并置——复古T恤与崭新手机——瞬间定格「青春期的时间错位感」：既怀旧又崭新。",
      "metaphor_analysis": "vintage（旧）与 brand new（新）的对撞是整首歌「记忆 vs 当下」主题的微缩模型。",
      "allusions": [],
      "wordplay": null,
      "emotional_tone": "nostalgia",
      "cultural_context": "High heels on cobblestones 暗示纽约西村的鹅卵石街道，为 folklore 的都市怀旧定调。",
      "taylor_swift_context": "folklore 开创了 Taylor 的虚构叙事时期，cardigan 是 Betty-James-Augustine 三角故事中 Betty 的视角。",
      "related_lines": [],
      "emotion_valence": 0.55,
      "emotion_arousal": 0.35,
      "emotion_category": "nostalgia"
    },
    {
      "line_index": 2,
      "lyric_text": "When you are young, they assume you know nothing",
      "summary": "副歌前的核心命题：成人世界对年轻人的傲慢假设。整首歌是对这句话的反驳——「但我知道」(But I knew you)。",
      "metaphor_analysis": null,
      "allusions": [
        "呼应彼得潘式的「永恒少年」主题（后文 Peter losing Wendy）"
      ],
      "wordplay": null,
      "emotional_tone": "regret",
      "cultural_context": null,
      "taylor_swift_context": "Taylor 在 folklore 纪录片中说，这句是整个三部曲的情感锚点：年轻人的感情被低估，但他们记得所有细节。",
      "related_lines": [],
      "emotion_valence": 0.4,
      "emotion_arousal": 0.45,
      "emotion_category": "regret"
    },
    {
      "line_index": 12,
      "lyric_text": "And when I felt like I was an old cardigan",
      "summary": "全曲核心意象：被遗忘在床下的旧开衫——不再被穿上、被选择的自我价值感的隐喻。",
      "metaphor_analysis": "本体：被忽视的自我；喻体：床下的旧开衫。「床下」意味着不可见、被搁置——不是被丢弃，而是被遗忘，这比丢弃更刺痛。",
      "allusions": [],
      "wordplay": "「put me on」双关：字面是「穿上我」，引申是「重视我/给我位置」。",
      "emotional_tone": "tenderness",
      "cultural_context": "开衫 (cardigan) 是温暖、居家、被包裹的象征物，Taylor 发行时同步售卖同款开衫周边，将隐喻实体化。",
      "taylor_swift_context": "Betty 视角：回忆 James 曾让她感到被珍视。与 betty、august 构成 folklore 三部曲。",
      "related_lines": [
        {
          "song": "All Too Well (10 Minute Version)",
          "album": "Red (Taylor's Version)",
          "line": "But you keep my old scarf from that very first week",
          "similarity": 0.78
        },
        {
          "song": "champagne problems",
          "album": "evermore",
          "line": "Your mom's ring in your pocket",
          "similarity": 0.62
        }
      ],
      "emotion_valence": 0.45,
      "emotion_arousal": 0.3,
      "emotion_category": "tenderness"
    },
    {
      "line_index": 14,
      "lyric_text": "You put me on and said I was your favorite",
      "summary": "隐喻的温柔顶点：被「穿上」即被选择、被贴近身体——亲密与依赖的具象化。",
      "metaphor_analysis": "延续衣物隐喻体系：从「床下」到「穿上」，是从被遗忘到被珍视的情感位移。",
      "allusions": [],
      "wordplay": "favorite 既指「最喜欢的衣物」也指「最爱的人」。",
      "emotional_tone": "love",
      "cultural_context": null,
      "taylor_swift_context": null,
      "related_lines": [],
      "emotion_valence": 0.75,
      "emotion_arousal": 0.45,
      "emotion_category": "love"
