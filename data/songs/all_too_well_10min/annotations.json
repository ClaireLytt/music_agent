  "annotations": [
    {
      "line_index": 2,
      "lyric_text": "And I, left my scarf there at your sister's house",
      "summary": "整首歌最著名的物件：留在对方姐姐家的围巾——被留下的不只是围巾，是一部分自我。",
      "metaphor_analysis": "围巾=纯真与亲密的信物。它被「留下」又被「保留」，成为一段关系的物证。",
      "allusions": [],
      "wordplay": null,
      "emotional_tone": "nostalgia",
      "cultural_context": "十年来粉丝反复追问「围巾在哪」，使它成为流行文化中最著名的失物之一。",
      "taylor_swift_context": "普遍认为写给 Jake Gyllenhaal，Maggie Gyllenhaal 曾在访谈中被问及围巾下落。",
      "related_lines": [
        {
          "song": "cardigan",
          "album": "folklore",
          "line": "And when I felt like I was an old cardigan under someone's bed",
          "similarity": 0.78
        }
      ],
      "emotion_valence": 0.4,
      "emotion_arousal": 0.35,
      "emotion_category": "nostalgia"
    },
    {
      "line_index": 6,
      "lyric_text": "Autumn leaves falling down like pieces into place",
      "summary": "秋叶落定如拼图归位——用季节意象把「回忆的必然性」写成风景。",
      "metaphor_analysis": "本体：记忆的碎片；喻体：落叶。falling into place 双重含义：物理落下 + 真相拼合。",
      "allusions": [],
      "wordplay": "pieces into place 既是叶子落地，也是回忆拼图完成。",
      "emotional_tone": "nostalgia",
      "cultural_context": null,
      "taylor_swift_context": null,
      "related_lines": [],
      "emotion_valence": 0.45,
      "emotion_arousal": 0.3,
      "emotion_category": "nostalgia"
    },
    {
      "line_index": 12,
      "lyric_text": "Wind in my hair, I was there, I remember it",
      "summary": "全曲的证词式宣言：「我在场，我记得」——用记忆对抗被抹除的叙事权。",
      "metaphor_analysis": null,
      "allusions": [],
      "wordplay": null,
      "emotional_tone": "nostalgia",
      "cultural_context": null,
      "taylor_swift_context": "10 分钟版本是 Taylor's Version 重录计划的核心宣言：夺回自己故事的所有权。",
      "related_lines": [],
      "emotion_valence": 0.35,
      "emotion_arousal": 0.55,
      "emotion_category": "nostalgia"
    },
    {
      "line_index": 46,
      "lyric_text": "I'm a crumpled up piece of paper lying here",
      "summary": "「你把我像一张揉皱的纸扔掉」——被弃感最物化、最锋利的表达。",
      "metaphor_analysis": "本体：被轻易结束的感情；喻体：揉皱的纸。纸曾承载文字（承诺），揉皱即背弃。",
      "allusions": [],
      "wordplay": null,
      "emotional_tone": "sadness",
      "cultural_context": null,
      "taylor_swift_context": null,
      "related_lines": [],
      "emotion_valence": 0.15,
      "emotion_arousal": 0.6,
      "emotion_category": "sadness"
    },
    {
      "line_index": 64,
      "lyric_text": "But you keep my old scarf from that very first week",
      "summary": "结尾回到围巾：对方留着它，「因为它闻起来像我，因为你无法摆脱回忆」——记忆是双向的囚笼。",
      "metaphor_analysis": "围巾从「我的失物」变成「你的收藏」，权力关系翻转：遗忘失败的是你。",
      "allusions": [],
      "wordplay": null,
      "emotional_tone": "loss",
