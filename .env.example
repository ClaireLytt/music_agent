# ── LLM Provider ──────────────────────────────────────────
LLM_PROVIDER=openai          # anthropic | openai
API_KEY=your-api-key-here
MODEL_NAME=deepseek-chat      # cost-effective for batch annotation
LLM_BASE_URL=https://api.deepseek.com

# ── LLM Tuning ───────────────────────────────────────────
MAX_TOKENS=16000
TEMPERATURE=0.3

# ── Embedding Model (for intertextuality) ─────────────────
EMBEDDING_PROVIDER=local      # local | openai
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Paths ─────────────────────────────────────────────────
SONGS_DIR=data/songs
CORPUS_DIR=data/corpus

# ── UI ────────────────────────────────────────────────────
UI_PORT=7860
UI_LANG=zh                    # zh | en

# ── Public deployment ─────────────────────────────────────
# PUBLIC_MODE=1  # each visitor uses their OWN API key (browser localStorage);
#                # library is read-only; chat history never touches server disk;
#                # hackathon-playlist songs are excluded (license: demo only)
