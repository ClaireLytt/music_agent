# ── LLM Provider ──────────────────────────────────────────
LLM_PROVIDER=openai          # anthropic | openai
API_KEY=your-api-key-here
MODEL_NAME=deepseek-chat      # cost-effective for batch annotation
LLM_BASE_URL=https://api.deepseek.com

# ── LLM Tuning ───────────────────────────────────────────
MAX_TOKENS=16000
TEMPERATURE=0.3

# ── Embedding Model (for intertextuality) ─────────────────
EMBEDDING_PROVIDER=local      # local | openai
EMBEDDING_MODEL=all-MiniLM-L6-v2
# For Chinese-heavy corpora use a multilingual model and rerun `lyric-agent embed`:
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ── 彩蛋 (easter-egg) detection thresholds ─────────────────
# strong echo: whole-song 🥚 map + artist network map
ECHO_MIN_SIMILARITY=0.62
# stricter cutoff when either line is mostly CJK (English MiniLM inflates
# Chinese similarities; CJK echoes also require a shared >=3-char phrase)
ECHO_MIN_SIMILARITY_CJK=0.90
# exploratory: per-line 互文追踪 panel (top-K cards)
ECHO_SEARCH_SIMILARITY=0.35
ECHO_SEARCH_SIMILARITY_CJK=0.60
ECHO_TOP_K=4
# busiest songs shown on the 彩蛋地图 network graph
ECHO_MAP_MAX_NODES=18

# ── Paths ─────────────────────────────────────────────────
SONGS_DIR=data/songs
CORPUS_DIR=data/corpus
EVOLUTION_PATH=data/evolution/evolution.json

# ── UI ────────────────────────────────────────────────────
UI_PORT=7860
UI_LANG=zh                    # zh | en

# ── Public deployment ─────────────────────────────────────
# PUBLIC_MODE=1  # each visitor uses their OWN API key (browser localStorage);
#                # library is read-only; chat history never touches server disk;
#                # hackathon-playlist songs are excluded (license: demo only)
